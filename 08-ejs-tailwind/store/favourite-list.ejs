<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/custom.css">
</head>

<body>
    <%- include("../partials/userNav") %>
        <div class="favHomeContainer">
            <div class="page-header">
                <h1>Your Favourite Homes ❤️</h1>
                <p>Here are the properties you loved.</p>
            </div>

            <div class="cardsContainer">
                <% favouriteHomes.forEach((newItems)=>{%>
                    <div class="favHomeCardContainer">
                        <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                            alt="Blue Apartment" width="100%">
                        <!-- <div>
                            <%= newItems.Name%>
                        </div> -->

                        <div class="bottomContainer">
                            <div class="NameandRatingContainer">
                                <h2>
                                    <%= newItems.Name%>
                                </h2>
                                <div>
                                    ⭐<%= newItems.Rating%>
                                </div>
                            </div>
                            <div class="LocationContainer1">
                                📍 <%= newItems.Location %>

                            </div>
                            <div class="priceremoveContainer">
                                <div class="priceContainer1">

                                    <div class="priceRate">Rs<%= newItems.Price %>
                                    </div>
                                    <div class="slash">/</div>
                                    <div class="night">night</div>

                                </div>
                                <button class="remove-btn" data-id="<%=newItems.id%>">Remove</button>

                            </div>
                        </div>

                    </div>
                    <%})%>
            </div>
        </div>

        </div>
        <%- include("../partials/footer") %>
        <script src="/js/removefav.js"></script>
</body>

</html>