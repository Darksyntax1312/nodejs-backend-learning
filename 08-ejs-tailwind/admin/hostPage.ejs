<%- include("../partials/head", { title: title }) %>

    <body>
        <%- include("../partials/Header") %>
            <center>
                <div class="addHomeContainer">

                    <h1>Add your home 🏡</h1>

                    <form method="POST" action="/host/add-home" class="formCollecting">
                        <div class="Items">
                            <label for="A1952">Home Name</label>
                            <input type="text" id="A1952" name="Name" placeholder="Enter home name here...">
                        </div>

                        <br>
                        <div class="Items">
                            <label for="PNI8">Price per Night</label>
                            <input type="text" id="PNI8" name="Price" placeholder="price per night....">
                        </div>
                        <br>
                        <div class="Items">
                            <label for="L1952">Location</label>
                            <input type="text" id="L1952" name="Location" placeholder="Enter you hotel location...">
                        </div>
                        <br>
                        <div class="Items">
                            <label for="R1952">Rating</label>
                            <input type="number" id="R1952" name="Rating" placeholder="Enter you hotel rating...">
                        </div>
                        <br>
                        <div class="Items">
                            <label for="P1953">Your Phone Number</label>
                            <input type="text" id="P1953" name="PhoneNumber" placeholder="Enter your phone number...">
                        </div>
                        <br>
                        <div class="Items">
                            <label for="I2985">Additional Details</label>
                            <input type="text" id="I2985" name="Details" placeholder="write more info....">
                        </div>

                        <br>
                        <input type="submit" value="Submit" class="submit">
                    </form>
                </div>
            </center>
            <%- include("../partials/footer") %>
    </body>

    </html>